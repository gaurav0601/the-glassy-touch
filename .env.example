# ============================================
# THE GLASSY TOUCH - ENVIRONMENT CONFIGURATION
# ============================================

# --- JWT Secret (used for admin authentication) ---
JWT_SECRET=your_jwt_secret_key_here

# --- Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="The Glassy Touch <your-email@gmail.com>"

# --- Store Details ---
STORE_NAME=The Glassy Touch
STORE_PHONE=+91-XXXXXXXXXX
STORE_EMAIL=info@theglassytouch.com
STORE_ADDRESS=Shop No. XX, Your Market, Your City, State - XXXXXX

# --- Google Maps Embed URL ---
GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# --- Base URL ---
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
